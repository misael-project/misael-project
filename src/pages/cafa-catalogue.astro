---
import "@fontsource/inter/variable.css";
import Footer from "~/components/footer.astro";
import Header from "~/components/header.astro";
import Intro from "~/components/cafa-catalog/index.astro";
import "~/styles/index.css";
import { getCollection } from "astro:content";

const { generator, site } = Astro;
const image = new URL("misaelLogoDark.png", site);
const description =
  "Misael Project; one-stop solution to support local creations and community development";

const circles = (await getCollection("circles")).sort(
  (a, b) => Date.parse(b.data.name) - Date.parse(a.data.name)
);
---

<!DOCTYPE html>
<html lang="en" class="h-full motion-safe:scroll-smooth" data-theme="light">
  <head>  
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="https://cdn.discordapp.com/attachments/583880464784424960/1241027326041657344/misael-icon.png?ex=6648b443&is=664762c3&hm=03219049157f1e25b6e12f14f6428c6757ffd46b6eb9a1afba7cefb33c4b0dc9&" type="image/png" />
    <meta name="generator" content={generator} />

    <title>Misael Project</title>
    <meta name="description" content={description} />

    <!-- social media -->
    <meta property="og:title" content="Misael Project" />
    <meta property="og:type" content="website" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:url" content={site} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- initialize theme -->
    <script type="text/partytown" src="https://www.googletagmanager.com/gtag/js?id=GTM-KL9HDTWD"></script>
    <script type="text/partytown">
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
  
      gtag('config', 'GTM-KL9HDTWD');
    </script>

  </head>
  <body
    class="h-full overflow-x-hidden bg-default text-default text-base selection:bg-secondary selection:text-white"
  >
    <Header />
    <div class="space-y-12 py-32">
      <Intro circles={circles}/>
    </div>
    <Footer />
    <script type="module">
      // Import the functions you need from the SDKs you need
      import { initializeApp } from "firebase/app";
      import { getAnalytics } from "firebase/analytics";
      // TODO: Add SDKs for Firebase products that you want to use
      // https://firebase.google.com/docs/web/setup#available-libraries

      // Your web app's Firebase configuration
      // For Firebase JS SDK v7.20.0 and later, measurementId is optional
      const firebaseConfig = {
        apiKey: "AIzaSyAZ_BL8Nf2KGephRdk5Ll7Pi3uC1qxJZXY",
        authDomain: "misael-project.firebaseapp.com",
        projectId: "misael-project",
        storageBucket: "misael-project.appspot.com",
        messagingSenderId: "197841362101",
        appId: "1:197841362101:web:bf381000c962b2960af2fc",
        measurementId: "G-6KEMLSRQEV"
      };

      // Initialize Firebase
      // const app = initializeApp(firebaseConfig);
      // const analytics = getAnalytics(app);
      const app = initializeApp(firebaseConfig);
      const analytics = getAnalytics(app);
    </script>
  </body>
</html>

